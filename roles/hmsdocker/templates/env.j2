CLOUDFLARE_DOMAIN={{ hmsdocker_cloudflare_ddns_zone }}
CLOUDFLARE_TUNNEL_TOKEN={{ hmsdocker_cloudflare_tunnel_token }}
### END Cloudflare

{% if 'authentik' in hmsdocker_enabled_containers and hmsdocker_ssl_enabled | default(False) %}
### BEGIN Authentik
# The `latest` tag was deprecated after 2025.2: https://docs.goauthentik.io/releases/2025.2#breaking-changes
AUTHENTIK_TAG={{ hmsdocker_authentik_version | default('2026.8') }}
{# Pull in the slurped data and decode it. #}
{# Separate files are used for these as they're supposed to remain persistent and should not be changed, and docker-compose cannot use an env_file setting and also reference it within compose in a ${} variable #}
AUTHENTIK_SECRET_KEY={{ hmsdocker_authentik_key -}}
PG_PASS={{ hmsdocker_authentik_pgpass -}}
PG_USER={{ hmsdocker_authentik_pg_user }}
PG_DB={{ hmsdocker_authentik_pg_db }}
{% if (hmsdocker_authentik_geoip_account_id | default('')) != '' and (hmsdocker_authentik_geoip_license_key | default('')) != '' %}
GEOIP_ACC_ID={{ hmsdocker_authentik_geoip_account_id }}
GEOIP_LIC_KEY={{ hmsdocker_authentik_geoip_license_key }}
{% endif %}
### END Authentik
{% endif %}

