{% import 'macros/labels.j2' as labels with context %}
{% set socket_proxy_client = 'traefik' %}
{% set socket_proxy_direct_mount = '/var/run/docker.sock:/var/run/docker.sock:ro' %}
services:
  traefik:
    image: traefik:${TRAEFIK_TAG:-v3.7.17}
    container_name: traefik
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    ports:
      - 80:80
      - 443:443
      - 443:443/udp
    {% if not hmsdocker_proxy_security_hardening and 'traefik' in hmsdocker_expose_ports_enabled_containers %}
      - 8080:8080
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
      - PUID=${PUID}
      - PGID=${PGID}
    {% if hmsdocker_ssl_dns_provider_environment_vars %}
        {% for key, value in hmsdocker_ssl_dns_provider_environment_vars.items() %}
        {# Due to how Ansible interprets curly brackets, I had to use 'raw' statements in order to render the ${} around the ansible 'key' variable to reference the .env file variable #}
      - {{ key }}={% raw %}${{% endraw %}{{ key }}{% raw %}}{% endraw +%}
        {% endfor %}
    {% endif %}
    networks:
      - proxy_net
    {% include 'socket_proxy/client_depends_on.j2' %}
    volumes:
    {% include 'socket_proxy/client_volume.j2' %}
      - ${HMSD_APPS_PATH}/traefik/config/traefik.yml:/etc/traefik/traefik.yml:ro
      - ${HMSD_APPS_PATH}/traefik/config/certs/:/certs/
      - {{ hmsdocker_traefik_static_config_location }}:/etc/traefik/static_files:ro
    {% if 'crowdsec' in hmsdocker_enabled_containers %}
      # CrowdSec bouncer plugin, downloaded by the playbook and loaded as a local plugin
      - ${HMSD_APPS_PATH}/crowdsec/bouncer-plugin/{{ hmsdocker_crowdsec_bouncer_plugin_version }}:{{ hmsdocker_crowdsec_bouncer_plugin_mount }}:ro
    {% endif %}
    {% if 'traefik' in hmsdocker_traefik_enabled_containers or ('traefik' in hmsdocker_homepage_enabled_containers and not hmsdocker_proxy_security_hardening) %}
    labels:
      {% if 'traefik' in hmsdocker_traefik_enabled_containers %}
      - traefik.enable=true
      - traefik.http.routers.traefik-${COMPOSE_PROJECT}.rule=Host(`{{ hmsdocker_container_map['traefik']['proxy_host_rule'] | default('traefik') }}.${HMSD_DOMAIN}`)
      - traefik.http.routers.traefik-${COMPOSE_PROJECT}.service=api@internal
      - traefik.http.routers.traefik-${COMPOSE_PROJECT}.middlewares={{ 'external' if 'traefik' in hmsdocker_expose_public_enabled_containers else 'internal' }}-{{ 'secured' if hmsdocker_proxy_security_hardening else 'ipallowlist' }}@file{{ ',authentik-proxy-${COMPOSE_PROJECT}-traefik-midware@docker' if 'traefik' in hmsdocker_authentik_enabled_containers }}{{ ',tinyauth-${COMPOSE_PROJECT}@docker' if 'traefik' in hmsdocker_tinyauth_applied_containers }}
      {% endif %}
      {% if 'traefik' in hmsdocker_homepage_enabled_containers and not hmsdocker_proxy_security_hardening %}
      {{ labels.homepage('traefik', 'Infrastructure', 'Traefik', 'Reverse Proxy', widget={'type': 'traefik', 'url': 'http://traefik:8080'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 15s
