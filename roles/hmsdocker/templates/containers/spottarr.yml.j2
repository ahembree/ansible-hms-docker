{% import 'macros/labels.j2' as labels with context %}
services:
  spottarr:
    image: ghcr.io/spottarr/spottarr:latest
    container_name: spottarr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    user: ${PUID}:${PGID}
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
      - download_net
    environment:
      - USENET__HOSTNAME=${SPOTTARR_USENET_HOSTNAME}
      - USENET__USERNAME=${SPOTTARR_USENET_USERNAME}
      - USENET__PASSWORD=${SPOTTARR_USENET_PASSWORD}
      - USENET__PORT=${SPOTTARR_USENET_PORT}
      - USENET__USETLS=${SPOTTARR_USENET_USE_TLS}
      - USENET__MAXCONNECTIONS=${SPOTTARR_USENET_MAX_CONNECTIONS}
      - SPOTNET__RETRIEVEAFTER=${SPOTTARR_RETRIEVE_AFTER}
      - SPOTNET__IMPORTBATCHSIZE=${SPOTTARR_IMPORT_BATCH_SIZE}
      - SPOTNET__RETENTIONDAYS=${SPOTTARR_RETENTION_DAYS}
      - SPOTNET__IMPORTADULTCONTENT=${SPOTTARR_IMPORT_ADULT_CONTENT}
      - NEWZNAB__APIKEY=${SPOTTARR_NEWZNAB_API_KEY}
      - TZ=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/spottarr/config:/data
    {% if 'spottarr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8383:8383
    {% endif %}
    {% if 'spottarr' in hmsdocker_traefik_enabled_containers or 'spottarr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'spottarr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('spottarr', 8383) | indent(6) }}
      {% endif %}
      {% if 'spottarr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('spottarr', 'Managers', 'Spottarr', 'Spotnet Indexer', icon='mdi-radar') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://localhost:8383/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 2h