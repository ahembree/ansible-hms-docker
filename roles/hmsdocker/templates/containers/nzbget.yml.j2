{% import 'macros/labels.j2' as labels with context %}
services:
  nzbget:
    image: lscr.io/linuxserver/nzbget:latest
    container_name: nzbget
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
      - download_net
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/nzbget/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if 'nzbget' in expose_ports_enabled_containers %}
    ports:
      - 6789:6789
    {% endif %}
    {% if 'nzbget' in traefik_enabled_containers or 'nzbget' in homepage_enabled_containers %}
    labels:
      {% if 'nzbget' in traefik_enabled_containers %}
      {{ labels.traefik('nzbget', 6789) | indent(6) }}
      {% endif %}
      {% if 'nzbget' in homepage_enabled_containers %}
      {{ labels.homepage('nzbget', 'Downloads', 'NZBget', 'NZB Manager', widget={'type': 'nzbget', 'url': 'http://nzbget:6789', 'username': '${NZBGET_USERNAME:-nzbget}', 'password': '${NZBGET_PASSWORD:-tegbzn6789}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:6789/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
