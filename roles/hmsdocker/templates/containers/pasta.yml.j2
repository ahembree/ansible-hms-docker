{% import 'macros/labels.j2' as labels with context %}
services:
  pasta:
    image: cglatot/pasta:latest
    container_name: pasta
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'pasta' in expose_ports_enabled_containers %}
    ports:
      - 8085:80
    {% endif %}
    {% if 'pasta' in traefik_enabled_containers %}
    labels:
      {{ labels.traefik('pasta', 80) | indent(6) }}
    {% endif %}
    # Image is httpd:2.4-alpine based: no bash, but busybox wget is available
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:80/"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
