{% import 'macros/labels.j2' as labels with context %}
services:
  deluge:
    image: binhex/arch-delugevpn
    container_name: deluge
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - download_net
      - proxy_net
    {% if hmsdocker_vpn_type == 'wireguard' %}
    privileged: true
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
    {% else %}
    cap_add:
      - NET_ADMIN
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
      - VPN_ENABLED=yes
      - VPN_USER=${VPN_USER}
      - VPN_PASS=${VPN_PASS}
      - VPN_PROV={{ (hmsdocker_vpn_provider | default('', true) | lower) if (hmsdocker_vpn_provider | default('', true) | lower) in ['pia', 'airvpn', 'protonvpn', 'custom'] else 'custom' }}
      - VPN_CLIENT={{ hmsdocker_vpn_type }}
      - ENABLE_PRIVOXY=yes
      - LAN_NETWORK={{ hms_docker_network_subnet }}
    volumes:
      - ${HMSD_APPS_PATH}/deluge/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if 'deluge' in expose_ports_enabled_containers %}
    ports:
      - 8112:8112
      - 8119:8118 # privoxy
    {% endif %}
    {% if 'deluge' in traefik_enabled_containers or 'deluge' in homepage_enabled_containers %}
    labels:
      {% if 'deluge' in traefik_enabled_containers %}
      {{ labels.traefik('deluge', 8112) | indent(6) }}
      {% endif %}
      {% if 'deluge' in homepage_enabled_containers %}
      {{ labels.homepage('deluge', 'Downloads', 'deluge', 'Torrent Management', widget={'type': 'deluge', 'url': 'http://deluge:8112', 'password': '${DELUGE_PASS:-deluge}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8112/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
