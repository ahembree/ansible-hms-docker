{% set socket_proxy_client = 'tinyauth' %}
{% set socket_proxy_direct_mount = '/var/run/docker.sock:/var/run/docker.sock:ro' %}
services:
  tinyauth:
    image: ghcr.io/tinyauthapp/tinyauth:v5
    container_name: tinyauth
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% include 'socket_proxy/client_depends_on.j2' %}
    {% if 'tinyauth' in expose_ports_enabled_containers %}
    ports:
      - 3004:3000
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
      - TINYAUTH_APPURL=http{{ 's' if traefik_ssl_enabled and 'tinyauth' in traefik_enabled_containers }}://{{ hms_docker_container_map['tinyauth']['proxy_host_rule'] | default('tinyauth') }}.${HMSD_DOMAIN}{{ ':3004' if 'tinyauth' not in traefik_enabled_containers and 'tinyauth' in expose_ports_enabled_containers }}
      - TINYAUTH_AUTH_USERS=${TINYAUTH_USERS:-}
      - TINYAUTH_AUTH_SECURECOOKIE={{ 'true' if traefik_ssl_enabled and 'tinyauth' in traefik_enabled_containers else 'false' }}
      - TINYAUTH_DATABASE_PATH=/data/tinyauth.db
      - TINYAUTH_RESOURCES_PATH=/data/resources
      {% if hmsdocker_tinyauth_oauth_whitelist | default([], true) | length > 0 %}
      - TINYAUTH_OAUTH_WHITELIST={{ hmsdocker_tinyauth_oauth_whitelist | join(',') | replace('$', '$$') }}
      {% endif %}
      {% if hmsdocker_tinyauth_pocketid_enabled | default(false) %}
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_NAME=Pocket ID
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_CLIENTID={{ hmsdocker_tinyauth_pocketid_client_id }}
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_CLIENTSECRETFILE=/data/.pocketid_client_secret
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_SCOPES=openid,email,profile,groups
        {% if hmsdocker_tinyauth_pocketid_external | bool %}
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_AUTHURL={{ hmsdocker_tinyauth_pocketid_base_url }}/authorize
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_TOKENURL={{ hmsdocker_tinyauth_pocketid_base_url }}/api/oidc/token
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_USERINFOURL={{ hmsdocker_tinyauth_pocketid_base_url }}/api/oidc/userinfo
        {% else %}
      # Opened by the browser
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_AUTHURL=https://{{ hms_docker_container_map['pocketid']['proxy_host_rule'] | default('pocketid') }}.${HMSD_DOMAIN}/authorize
      # Called by Tinyauth over the Docker network
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_TOKENURL=http://pocketid:1411/api/oidc/token
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_USERINFOURL=http://pocketid:1411/api/oidc/userinfo
        {% endif %}
      - TINYAUTH_OAUTH_PROVIDERS_pocketid_REDIRECTURL=https://{{ hms_docker_container_map['tinyauth']['proxy_host_rule'] | default('tinyauth') }}.${HMSD_DOMAIN}/api/oauth/callback/pocketid
        {% if hmsdocker_tinyauth_pocketid_auto_redirect | default(false) %}
      - TINYAUTH_OAUTH_AUTOREDIRECT=pocketid
        {% endif %}
      {% endif %}
      {% if 'tinyauth' in socket_proxy_no_access_containers %}
      - TINYAUTH_LABELPROVIDER=none
      {% endif %}
    {% include 'socket_proxy/client_docker_host.j2' %}
    volumes:
      - ${HMSD_APPS_PATH}/tinyauth/config:/data
    # Used to read tinyauth access-control labels from other containers
    {% include 'socket_proxy/client_volume.j2' %}
    {% if 'tinyauth' in traefik_enabled_containers or 'tinyauth' in homepage_enabled_containers %}
    labels:
      {% if 'tinyauth' in traefik_enabled_containers %}
      - traefik.enable=true
      - traefik.http.services.tinyauth-${COMPOSE_PROJECT}.loadbalancer.server.port=3000
      - traefik.http.routers.tinyauth-${COMPOSE_PROJECT}.rule=Host(`{{ hms_docker_container_map['tinyauth']['proxy_host_rule'] | default('tinyauth') }}.${HMSD_DOMAIN}`)
      - traefik.http.routers.tinyauth-${COMPOSE_PROJECT}.middlewares={{ 'external' if 'tinyauth' in expose_public_enabled_containers else 'internal' }}-{{ 'secured' if traefik_security_hardening else 'ipallowlist' }}@file{{ ',authentik-proxy-${COMPOSE_PROJECT}-tinyauth-midware@docker' if 'tinyauth' in authentik_enabled_containers }}
      # Forward-auth middleware, add `tinyauth-${COMPOSE_PROJECT}@docker` to another router's middlewares to protect it
      - traefik.http.middlewares.tinyauth-${COMPOSE_PROJECT}.forwardauth.address=http://tinyauth:3000/api/auth/traefik
      {% endif %}
      {% if 'tinyauth' in homepage_enabled_containers %}
      - homepage.group=Infrastructure
      - homepage.name=Tinyauth
      - homepage.icon=tinyauth.png
      - homepage.href=http://{{ hms_docker_container_map['tinyauth']['proxy_host_rule'] | default('tinyauth') }}.${HMSD_DOMAIN}
      - homepage.description=Authentication Middleware
        {% if 'tinyauth' in homepage_stats_enabled_containers %}
      - homepage.showStats=true
        {% endif %}
      {% endif %}
    {% endif %}
    healthcheck:
      test: ["CMD", "tinyauth", "healthcheck"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
