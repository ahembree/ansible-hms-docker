{% import 'macros/labels.j2' as labels with context %}
services:
  overseerr:
    image: linuxserver/overseerr:latest
    container_name: overseerr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    {% if 'overseerr' in hmsdocker_traefik_enabled_containers or 'overseerr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'overseerr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('overseerr', 5055) | indent(6) }}
      {% endif %}
      {% if 'overseerr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('overseerr', 'Managers', 'Overseerr', 'Request Manager', widget={'type': 'seerr', 'url': 'http://overseerr:5055', 'key': '${OVERSEERR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/overseerr/config:/config
    {% if 'overseerr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 5055:5055
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:5055 || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
