{% import 'macros/labels.j2' as labels with context %}
services:
  fileflows:
    image: revenz/fileflows
    container_name: fileflows
    restart: ${RESTART_POLICY}
    # Cannot enable security_opt:no-new-privileges due to Dockermods within the container needing to run sudo in order to install requirements, such as ffmpeg
    #security_opt:
    #  - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    {% if 'fileflows' in expose_ports_enabled_containers %}
    ports:
      - "19200:5000"
    {% endif %}
    networks:
      - proxy_net
    {% if enable_intel_gpu %}
    devices:
      - "/dev/dri:/dev/dri"
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
      - PUID=${PUID}
      - PGID=${PGID}
    {% if enable_nvidia_gpu %}
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    # No Docker socket: FileFlows only uses it for its optional "Docker Siblings" runners, which this
    # project does not set up. Add the socket and TempPathHost with a docker-compose.override.yml to use them
    volumes:
      - ${HMSD_APPS_PATH}/fileflows/config:/app/Data
      - ${HMSD_APPS_PATH}/fileflows/logs:/app/Logs
      - ${HMSD_APPS_PATH}/fileflows/common:/app/common
      - ${HMSD_MOUNT_PATH}:/data
      - {{ hmsdocker_transcode_temp_path }}/fileflows:/temp
    {% if 'fileflows' in traefik_enabled_containers or 'fileflows' in homepage_enabled_containers %}
    labels:
      {% if 'fileflows' in traefik_enabled_containers %}
      {{ labels.traefik('fileflows', 5000) | indent(6) }}
      {% endif %}
      {% if 'fileflows' in homepage_enabled_containers %}
      {{ labels.homepage('fileflows', 'Media', 'Fileflows', 'Media Transcoder', widget={'type': 'fileflows', 'url': 'http://fileflows:5000', 'version': '2', 'key': '${FILEFLOWS_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:5000 || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
