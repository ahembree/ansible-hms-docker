{% import 'macros/labels.j2' as labels with context %}
services:
  seerr:
    image: ghcr.io/seerr-team/seerr:latest
    init: true
    container_name: seerr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    user: ${PUID}:${PGID}
    environment:
      - LOG_LEVEL=debug
      - TZ=${TIMEZONE}
      - PORT=5055 #optional
    {% if 'seerr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 5055:5055
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/seerr/config:/app/config
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://127.0.0.1:5055/api/v1/settings/public || exit 1
      start_period: 20s
      timeout: 3s
      interval: 15s
      retries: 3
    {% if 'seerr' in hmsdocker_traefik_enabled_containers or 'seerr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'seerr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('seerr', 5055) | indent(6) }}
      {% endif %}
      {% if 'seerr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('seerr', 'Managers', 'Seerr', 'Request Manager', widget={'type': 'seerr', 'url': 'http://seerr:5055', 'key': '${SEERR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
