{% import 'macros/labels.j2' as labels with context %}
services:
  bazarr:
    image: linuxserver/bazarr:latest
    container_name: bazarr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    healthcheck:
      test: curl -f http://127.0.0.1:6767/health || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 20s
    {% if 'bazarr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 6767:6767
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/bazarr/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if 'bazarr' in hmsdocker_traefik_enabled_containers or 'bazarr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'bazarr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('bazarr', 6767) | indent(6) }}
      {% endif %}
      {% if 'bazarr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('bazarr', 'Managers', 'Bazarr', 'Subtitle Manager', widget={'type': 'bazarr', 'url': 'http://bazarr:6767', 'key': '${BAZARR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
