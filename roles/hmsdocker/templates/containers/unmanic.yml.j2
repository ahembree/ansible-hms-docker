{% import 'macros/labels.j2' as labels with context %}
services:
  unmanic:
    image: josh5/unmanic:latest
    container_name: unmanic
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    {% if enable_intel_gpu %}
    devices:
      - "/dev/dri:/dev/dri"
    {% endif %}
    {% if 'unmanic' in expose_ports_enabled_containers %}
    ports:
      - 8889:8888
    {% endif %}
    networks:
      - proxy_net
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    {% if enable_nvidia_gpu %}
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/unmanic/config:/config
      - ${HMSD_MOUNT_PATH}:/library
      - {{ hmsdocker_transcode_temp_path }}/unmanic:/tmp/unmanic
    {% if 'unmanic' in traefik_enabled_containers or 'unmanic' in homepage_enabled_containers %}
    labels:
      {% if 'unmanic' in traefik_enabled_containers %}
      {{ labels.traefik('unmanic', 8888) | indent(6) }}
      {% endif %}
      {% if 'unmanic' in homepage_enabled_containers %}
      {{ labels.homepage('unmanic', 'Media', 'unmanic', 'Media Transcoder', href='https', widget={'type': 'unmanic', 'url': 'http://unmanic:8888'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8888 || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
