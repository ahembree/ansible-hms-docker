{% import 'macros/labels.j2' as labels with context %}
services:
  tailscale:
    image: tailscale/tailscale:latest
    container_name: tailscale
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - ${HMSD_APPS_PATH}/tailscale/state:/var/lib/tailscale
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - TS_AUTHKEY=${TAILSCALE_AUTH_KEY}
      - TS_STATE_DIR=/var/lib/tailscale
    {% if hmsdocker_tailscale_enable_subnet_routes %}
      - TS_ROUTES={{ hmsdocker_tailscale_subnet_routes }}
    {% endif %}
    {% if hmsdocker_tailscale_advertise_exit_node %}
      - TS_EXTRA_ARGS=--advertise-exit-node
    {% endif %}
    {% if 'tailscale' in hmsdocker_homepage_enabled_containers %}
    labels:
      {{ labels.homepage('tailscale', 'Infrastructure', 'Tailscale', 'VPN', href=none, widget={'type': 'tailscale', 'deviceid': '${TAILSCALE_DEVICE_ID}', 'key': '${TAILSCALE_API_KEY}'}, stats=false) | indent(6) }}
    {% endif %}
