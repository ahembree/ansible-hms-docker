{% import 'macros/labels.j2' as labels with context %}
services:
  checkrr:
    image: aetaric/checkrr:latest
    container_name: checkrr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'checkrr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8585:8585
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/checkrr/config:/etc/checkrr
      - ${HMSD_MOUNT_PATH}:/data:ro
    {% if 'checkrr' in hmsdocker_traefik_enabled_containers or 'checkrr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'checkrr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('checkrr', 8585) | indent(6) }}
      {% endif %}
      {% if 'checkrr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('checkrr', 'Managers', 'Checkrr', 'Media Integrity Scanner', href='https') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: wget --spider -q http://127.0.0.1:8585/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
