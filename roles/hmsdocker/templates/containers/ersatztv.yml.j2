{% import 'macros/labels.j2' as labels with context %}
services:
  ersatztv:
    image: ghcr.io/ersatztv/legacy:latest
    container_name: ersatztv
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    # ErsatzTV does not use PUID/PGID environment variables
    user: ${PUID}:${PGID}
    networks:
      - proxy_net
    {% if 'ersatztv' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8409:8409
    {% endif %}
    {% if hmsdocker_enable_intel_gpu %}
    devices:
      - /dev/dri:/dev/dri
    {% if hmsdocker_ersatztv_render_gid is defined %}
    group_add:
      - "{{ hmsdocker_ersatztv_render_gid }}"
    {% endif %}
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/ersatztv/config:/config
      {% if not hmsdocker_transcode_tmpfs_enabled | default(false) %}
      - ${HMSD_APPS_PATH}/ersatztv/transcode:/transcode
      {% endif %}
      # media folder, used by local libraries and to play media from Plex/Jellyfin/Emby directly from disk
      - ${HMSD_MOUNT_PATH}:/data{{ ':ro' if 'ersatztv' in hmsdocker_readonly_media_containers | default([], true) }}
    {% if hmsdocker_transcode_tmpfs_enabled | default(false) %}
    tmpfs:
      - /transcode:size={{ hmsdocker_transcode_tmpfs_size | default('4g') }},mode=1777
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
    {% if hmsdocker_enable_nvidia_gpu %}
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    {% if 'ersatztv' in hmsdocker_traefik_enabled_containers or 'ersatztv' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'ersatztv' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('ersatztv', 8409) | indent(6) }}
      {% endif %}
      {% if 'ersatztv' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('ersatztv', 'Media', 'ErsatzTV', 'Live TV Channels') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -fsS -o /dev/null http://127.0.0.1:8409/iptv/channels.m3u || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
