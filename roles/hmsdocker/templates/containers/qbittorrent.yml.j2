{% import 'macros/labels.j2' as labels with context %}
services:
  qbittorrent:
    image: binhex/arch-qbittorrentvpn
    container_name: qbittorrent
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - download_net
      - proxy_net
    {% if hmsdocker_vpn_type == 'wireguard' %}
    cap_add:
      - NET_ADMIN
    sysctls:
      - net.ipv4.conf.all.src_valid_mark=1
    {% else %}
    cap_add:
      - NET_ADMIN
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
      - WEBUI_PORT=8086
      - VPN_ENABLED=yes
      - VPN_USER=${VPN_USER}
      - VPN_PASS=${VPN_PASS}
      - VPN_PROV={{ (hmsdocker_vpn_provider | default('', true) | lower) if (hmsdocker_vpn_provider | default('', true) | lower) in ['pia', 'airvpn', 'protonvpn', 'custom'] else 'custom' }}
      - VPN_CLIENT={{ hmsdocker_vpn_type }}
      - ENABLE_PRIVOXY=yes
      - LAN_NETWORK={{ hms_docker_network_subnet }}
    volumes:
      - ${HMSD_APPS_PATH}/qbittorrent/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if 'qbittorrent' in expose_ports_enabled_containers %}
    ports:
      - 8086:8086
      - 8118:8118 # privoxy
    {% endif %}
    {% if 'qbittorrent' in traefik_enabled_containers or 'qbittorrent' in homepage_enabled_containers %}
    labels:
      {% if 'qbittorrent' in traefik_enabled_containers %}
      {{ labels.traefik('qbittorrent', 8086) | indent(6) }}
      {% endif %}
      {% if 'qbittorrent' in homepage_enabled_containers %}
      {{ labels.homepage('qbittorrent', 'Downloads', 'qbittorrent', 'Torrent Management', widget={'type': 'qbittorrent', 'url': 'http://qbittorrent:8086', 'username': '${QBITTORRENT_USER:-admin}', 'password': '${QBITTORRENT_PASS}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8086/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
