{% import 'macros/labels.j2' as labels with context %}
services:
  backrest:
    image: garethgeorge/backrest
    container_name: backrest
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
      - BACKREST_DATA=/data # path for backrest data. restic binary and the database are placed here.
      - BACKREST_CONFIG=/config/config.json # path for the backrest config file.
      - XDG_CACHE_HOME=/cache # path for the restic cache which greatly improves performance.
    volumes:
      - ${HMSD_APPS_PATH}/backrest/config:/config
      - ${HMSD_APPS_PATH}/backrest/repo_configs:/root/.config
      - ${HMSD_APPS_PATH}/backrest/data:/data
      - ${HMSD_APPS_PATH}/backrest/cache:/cache
      - {{ hms_docker_data_path }}:/opt/hms-docker{{ ':ro' if not hmsdocker_backrest_allow_write | default(false) }}
      {% if hmsdocker_backrest_enable_restore_path | default(false) %}
      - {{ hmsdocker_backrest_restore_path }}:/opt/hms-backup-restore
      {% endif %}
    {% if 'backrest' in expose_ports_enabled_containers %}
    ports:
      - 9898:9898
    {% endif %}
    {% if 'backrest' in traefik_enabled_containers or 'backrest' in homepage_enabled_containers %}
    labels:
      {% if 'backrest' in traefik_enabled_containers %}
      {{ labels.traefik('backrest', 9898) | indent(6) }}
      {% endif %}
      {% if 'backrest' in homepage_enabled_containers %}
      {{ labels.homepage('backrest', 'Infrastructure', 'backrest', 'Backup System', widget={'type': 'backrest', 'url': 'http://backrest:9898', 'username': '${BACKREST_USERNAME:-apikeyapikeyapikey}', 'password': '${BACKREST_PASSWORD:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:9898/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
