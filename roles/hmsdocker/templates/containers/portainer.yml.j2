{% import 'macros/labels.j2' as labels with context %}
services:
  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer
    command: -H unix:///var/run/docker.sock
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'portainer' in expose_ports_enabled_containers %}
    ports:
      - 9000:9000
    {% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ${HMSD_APPS_PATH}/portainer/config:/data
    {% if 'portainer' in traefik_enabled_containers or 'portainer' in homepage_enabled_containers %}
    labels:
      {% if 'portainer' in traefik_enabled_containers %}
      {{ labels.traefik('portainer', 9000) | indent(6) }}
      {% endif %}
      {% if 'portainer' in homepage_enabled_containers %}
      {{ labels.homepage('portainer', 'Infrastructure', 'Portainer', 'Container Management', widget={'type': 'portainer', 'url': 'https://portainer:9443', 'env': '1', 'key': '${PORTAINER_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
