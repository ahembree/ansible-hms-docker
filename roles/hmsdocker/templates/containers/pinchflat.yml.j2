{% import 'macros/labels.j2' as labels with context %}
services:
  pinchflat:
    image: ghcr.io/kieraneglin/pinchflat:latest
    container_name: pinchflat
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    environment:
      - TZ=${TIMEZONE}
    {% if 'pinchflat' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8945:8945
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/pinchflat/config:/config
      - ${HMSD_MOUNT_PATH}/{{ hmsdocker_primary_mount_name }}/{{ hmsdocker_library_folder_name }}/youtube/pinchflat:/downloads
    {% if 'pinchflat' in hmsdocker_traefik_enabled_containers or 'pinchflat' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'pinchflat' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('pinchflat', 8945) | indent(6) }}
      {% endif %}
      {% if 'pinchflat' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('pinchflat', 'Managers', 'Pinchflat', 'YouTube Archiver', href='https') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8945/healthcheck || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
