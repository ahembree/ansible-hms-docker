{% import 'macros/labels.j2' as labels with context %}
services:
  nexroll:
    image: jbrns/nexroll:latest
    container_name: nexroll
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'nexroll' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 9393:9393
    {% endif %}
    volumes:
      # NeXroll keeps its database, secrets, logs and thumbnails in /data
      - ${HMSD_APPS_PATH}/nexroll/config:/data
      # Prerolls live on the media share and are mounted at the same path the media servers use,
      # so the path NeXroll sends to Plex is already correct and needs no path mapping
      - ${HMSD_MOUNT_PATH}/{{ hmsdocker_primary_mount_name }}/prerolls:/data/{{ hmsdocker_primary_mount_name }}/prerolls
    environment:
      - TZ=${TIMEZONE}
      - PUID=${PUID}
      - PGID=${PGID}
      - NEXROLL_RUN_AS_PUID=true
      - NEXROLL_PREROLL_PATH=/data/{{ hmsdocker_primary_mount_name }}/prerolls
    {% if 'plex' in hmsdocker_enabled_containers %}
      - PLEX_URL=http://plex:32400
      - PLEX_TOKEN=${PLEX_KEY}
    {% endif %}
    {% if 'nexroll' in hmsdocker_traefik_enabled_containers or 'nexroll' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'nexroll' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('nexroll', 9393) | indent(6) }}
      {% endif %}
      {% if 'nexroll' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('nexroll', 'Media', 'NeXroll', 'Preroll Manager', icon='mdi-movie-open-play') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -fsS http://127.0.0.1:9393/health || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
