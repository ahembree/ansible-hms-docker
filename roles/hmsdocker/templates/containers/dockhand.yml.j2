{% import 'macros/labels.j2' as labels with context %}
services:
  dockhand:
    image: fnsys/dockhand:latest
    container_name: dockhand
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'dockhand' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 3003:3000
    {% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ${HMSD_APPS_PATH}/dockhand/config:/app/data
    {% if 'dockhand' in hmsdocker_traefik_enabled_containers or 'dockhand' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'dockhand' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('dockhand', 3000) | indent(6) }}
      {% endif %}
      {% if 'dockhand' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('dockhand', 'Infrastructure', 'Dockhand', 'Container Management', widget={'type': 'dockhand', 'url': 'http://dockhand:3000', 'username': '${DOCKHAND_USER:-dockhanduserisblank}', 'password': '${DOCKHAND_PASS:-dockhandpasswordisblank}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:3000/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
