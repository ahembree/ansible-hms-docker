{% import 'macros/labels.j2' as labels with context %}
services:
  autobrr:
    container_name: autobrr
    image: ghcr.io/autobrr/autobrr:latest
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    networks:
      - proxy_net
      - download_net
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    user: ${PUID}:${PGID}
    environment:
      - TZ=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/autobrr/config:/config
    {% if 'autobrr' in expose_ports_enabled_containers %}
    ports:
      - 7474:7474
    {% endif %}
    {% if 'autobrr' in traefik_enabled_containers or 'autobrr' in homepage_enabled_containers %}
    labels:
      {% if 'autobrr' in traefik_enabled_containers %}
      {{ labels.traefik('autobrr', 7474) | indent(6) }}
      {% endif %}
      {% if 'autobrr' in homepage_enabled_containers %}
      {{ labels.homepage('autobrr', 'Downloads', 'Autobrr', 'Torrent Automation', widget={'type': 'autobrr', 'url': 'http://autobrr:7474', 'key': '${AUTOBRR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:7474/api/healthz/liveness || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
