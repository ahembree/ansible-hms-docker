{% import 'macros/labels.j2' as labels with context %}
services:
  plex:
    image: lscr.io/linuxserver/plex:latest
    container_name: plex
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    {% if hmsdocker_enable_intel_gpu %}
    devices:
      - /dev/dri:/dev/dri
    {% endif %}
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    ports:
      - 32400:32400/tcp
      - 8324:8324/tcp
      - 32469:32469/tcp
      - 1900:1900/udp
      - 32410:32410/udp
      - 32412:32412/udp
      - 32413:32413/udp
      - 32414:32414/udp
    environment:
      - VERSION=docker
      - TZ=${TIMEZONE}
      - PUID=${PUID}
      - PGID=${PGID}
      - PLEX_CLAIM=${PLEX_CLAIM_TOKEN}
    {% if hmsdocker_enable_nvidia_gpu %}
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/plex/config:/config
      {% if not hmsdocker_transcode_tmpfs_enabled | default(false) %}
      # temp folder for Plex transcoding
      - {{ hmsdocker_plex_transcode_folder }}:/transcode
      {% endif %}
      # media folder where all movies and series are stored
      - ${HMSD_MOUNT_PATH}:/data{{ ':ro' if 'plex' in hmsdocker_readonly_media_containers | default([], true) }}
    {% if hmsdocker_transcode_tmpfs_enabled | default(false) %}
    tmpfs:
      - /transcode:size={{ hmsdocker_transcode_tmpfs_size | default('4g') }},mode=1777
    {% endif %}
    {% if 'plex' in hmsdocker_traefik_enabled_containers or 'plex' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'plex' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('plex', 32400, scheme='https') | indent(6) }}
      {% endif %}
      {% if 'plex' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('plex', 'Media', 'Plex', 'Media Server', widget={'type': 'plex', 'url': 'https://plex:32400', 'key': '${PLEX_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:32400/identity || exit 1
      interval: 5s
      timeout: 5s
      retries: 3
      start_period: 30s
