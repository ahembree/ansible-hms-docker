{% import 'macros/labels.j2' as labels with context %}
services:
  pocketid:
    image: ghcr.io/pocket-id/pocket-id:v2
    container_name: pocketid
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'pocketid' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 1411:1411
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
      - APP_URL=http{{ 's' if hmsdocker_traefik_ssl_enabled and 'pocketid' in hmsdocker_traefik_enabled_containers }}://{{ hmsdocker_container_map['pocketid']['proxy_host_rule'] | default('pocketid') }}.${HMSD_DOMAIN}{{ ':1411' if 'pocketid' not in hmsdocker_traefik_enabled_containers and 'pocketid' in hmsdocker_expose_ports_enabled_containers }}
      - TRUST_PROXY={{ 'true' if 'pocketid' in hmsdocker_traefik_enabled_containers else 'false' }}
      # Generated by the pocketid prereq tasks
      - ENCRYPTION_KEY_FILE=/app/data/.pocketid_encryption_key
      {% if hmsdocker_tinyauth_pocketid_local | bool %}
      # Used by the playbook to create the Tinyauth OIDC client
      - STATIC_API_KEY_FILE=/app/data/.pocketid_static_api_key
      {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/pocketid/config:/app/data
    {% if 'pocketid' in hmsdocker_traefik_enabled_containers or 'pocketid' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'pocketid' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('pocketid', 1411, tinyauth=false) | indent(6) }}
      {% endif %}
      {% if 'pocketid' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('pocketid', 'Infrastructure', 'Pocket ID', 'OIDC Provider', icon='pocket-id.png') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: ["CMD", "/app/pocket-id", "healthcheck"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
