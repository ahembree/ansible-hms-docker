services:
  pocketid:
    image: ghcr.io/pocket-id/pocket-id:v2
    container_name: pocketid
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'pocketid' in expose_ports_enabled_containers %}
    ports:
      - 1411:1411
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
      - APP_URL=http{{ 's' if traefik_ssl_enabled and 'pocketid' in proxy_enabled_containers }}://{{ hms_docker_container_map['pocketid']['proxy_host_rule'] | default('pocketid') }}.${HMSD_DOMAIN}{{ ':1411' if 'pocketid' not in proxy_enabled_containers and 'pocketid' in expose_ports_enabled_containers }}
      - TRUST_PROXY={{ 'true' if 'pocketid' in proxy_enabled_containers else 'false' }}
      # Generated by the pocketid prereq tasks
      - ENCRYPTION_KEY_FILE=/app/data/.pocketid_encryption_key
      {% if hmsdocker_tinyauth_pocketid_local | bool %}
      # Used by the playbook to create the Tinyauth OIDC client
      - STATIC_API_KEY_FILE=/app/data/.pocketid_static_api_key
      {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/pocketid/config:/app/data
    {% if 'pocketid' in traefik_enabled_containers or 'pocketid' in homepage_enabled_containers %}
    labels:
      {% if 'pocketid' in traefik_enabled_containers %}
      - traefik.enable=true
      - traefik.http.services.pocketid-${COMPOSE_PROJECT}.loadbalancer.server.port=1411
      - traefik.http.routers.pocketid-${COMPOSE_PROJECT}.rule=Host(`{{ hms_docker_container_map['pocketid']['proxy_host_rule'] | default('pocketid') }}.${HMSD_DOMAIN}`)
      - traefik.http.routers.pocketid-${COMPOSE_PROJECT}.middlewares={{ 'external' if 'pocketid' in expose_public_enabled_containers else 'internal' }}-{{ 'secured' if traefik_security_hardening else 'ipallowlist' }}@file{{ ',authentik-proxy-${COMPOSE_PROJECT}-pocketid-midware@docker' if 'pocketid' in authentik_enabled_containers }}
      {% endif %}
      {% if 'pocketid' in homepage_enabled_containers %}
      - homepage.group=Infrastructure
      - homepage.name=Pocket ID
      - homepage.icon=pocket-id.png
      - homepage.href=http://{{ hms_docker_container_map['pocketid']['proxy_host_rule'] | default('pocketid') }}.${HMSD_DOMAIN}
      - homepage.description=OIDC Provider
        {% if 'pocketid' in homepage_stats_enabled_containers %}
      - homepage.showStats=true
        {% endif %}
      {% endif %}
    {% endif %}
    healthcheck:
      test: ["CMD", "/app/pocket-id", "healthcheck"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
