{% import 'macros/labels.j2' as labels with context %}
services:
  lidarr:
    image: lscr.io/linuxserver/lidarr:latest
    container_name: lidarr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    networks:
      - proxy_net
      - download_net
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    {% if 'lidarr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8686:8686
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/lidarr/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if hmsdocker_svc_misc_arr_scripts_enabled | default(false) %}
      - ${HMSD_APPS_PATH}/lidarr/custom-services.d:/custom-services.d
      - ${HMSD_APPS_PATH}/lidarr/custom-cont-init.d:/custom-cont-init.d
    {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    {% if 'lidarr' in hmsdocker_traefik_enabled_containers or 'lidarr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'lidarr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('lidarr', 8686) | indent(6) }}
      {% endif %}
      {% if 'lidarr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('lidarr', 'Managers', 'Lidarr', 'Music Manager', widget={'type': 'lidarr', 'url': 'http://lidarr:8686', 'key': '${LIDARR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8686/health || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
