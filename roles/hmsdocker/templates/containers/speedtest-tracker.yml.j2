{% import 'macros/labels.j2' as labels with context %}
services:
  speedtest-tracker:
    image: lscr.io/linuxserver/speedtest-tracker:latest
    container_name: speedtest-tracker
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
  {% if 'speedtest-tracker' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8090:80
      - 8444:443
  {% endif %}
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - APP_KEY=${SPEEDTEST_API_KEY}
      - APP_URL=http://{{ hmsdocker_container_map['speedtest-tracker']['proxy_host_rule'] | default('speedtest') }}.${HMSD_DOMAIN}
      - DB_CONNECTION=sqlite
      - SPEEDTEST_SCHEDULE=${SPEEDTEST_SCHEDULE}
      - APP_TIMEZONE=${TIMEZONE}
      - DISPLAY_TIMEZONE=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/speedtest-tracker/config:/config
    {% if 'speedtest-tracker' in hmsdocker_traefik_enabled_containers or 'speedtest-tracker' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'speedtest-tracker' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('speedtest-tracker', 80, router='speedtest') | indent(6) }}
      {% endif %}
      {% if 'speedtest-tracker' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('speedtest-tracker', 'Infrastructure', 'Speedtest Tracker', 'Speedtest Tracker', host_default='speedtest', widget={'type': 'speedtest', 'url': 'http://speedtest-tracker', 'version': '2', 'key': '${HOMEPAGE_SPEEDTEST_API_KEY}', 'bitratePrecision': '1'}, stats=false) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:80/ || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s
