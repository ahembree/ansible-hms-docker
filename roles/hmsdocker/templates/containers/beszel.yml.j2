{% import 'macros/labels.j2' as labels with context %}
{% set socket_proxy_client = 'beszel' %}
{% set socket_proxy_direct_mount = '/var/run/docker.sock:/var/run/docker.sock:ro' %}
{% set socket_proxy_env_map = true %}
services:
  beszel:
    image: henrygd/beszel:latest
    container_name: beszel
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    environment:
      APP_URL: http{{ 's' if hmsdocker_ssl_enabled }}://{{ hmsdocker_container_map['beszel']['proxy_host_rule'] | default('beszel') }}.${HMSD_DOMAIN}{{ ':8091' if 'beszel' in hmsdocker_expose_ports_enabled_containers }}
      HEARTBEAT_URL: ${BESZEL_HEARTBEAT_URL:-}
    {% if 'beszel' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8091:8090
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/beszel/config/beszel_data:/beszel_data
      - ${HMSD_APPS_PATH}/beszel/config/beszel_socket:/beszel_socket
    {% if 'beszel' in hmsdocker_traefik_enabled_containers or 'beszel' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'beszel' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('beszel', 8090) | indent(6) }}
      {% endif %}
      {% if 'beszel' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('beszel', 'Infrastructure', 'beszel', 'Monitoring', widget={'type': 'beszel', 'url': 'http://beszel:8090', 'username': '${BESZEL_EMAIL:-}', 'password': '${BESZEL_PASSWORD:-}', 'version': '2'}) | indent(6) }}
      {% endif %}
    {% endif %}
    # Image is distroless — no shell, curl, or wget. The beszel binary ships
    # a built-in `health` subcommand that hits the hub's /api/health endpoint.
    healthcheck:
      test: ["CMD", "/beszel", "health", "--url", "http://127.0.0.1:8090"]
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 30s

  beszel-agent:
    image: henrygd/beszel-agent:alpine
    container_name: beszel-agent
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    network_mode: host
    {% include 'socket_proxy/client_depends_on.j2' %}
    volumes:
      - ${HMSD_APPS_PATH}/beszel/config/beszel_agent_data:/var/lib/beszel-agent
      - ${HMSD_APPS_PATH}/beszel/config/beszel_socket:/beszel_socket
    {% include 'socket_proxy/client_volume.j2' %}
    environment:
      LISTEN: /beszel_socket/beszel.sock
    {% include 'socket_proxy/client_docker_host.j2' %}
      HUB_URL: http{{ 's' if hmsdocker_ssl_enabled }}://{{ hmsdocker_container_map['beszel']['proxy_host_rule'] | default('beszel') }}.${HMSD_DOMAIN}{{ ':8091' if 'beszel' in hmsdocker_expose_ports_enabled_containers }}
      TOKEN: ${BESZEL_TOKEN:-}
      KEY: ${BESZEL_KEY:-}
    devices:
    {% for device in hmsdocker_monitor_disk_devices %}
      - {{ device }}
    {% endfor %}
    cap_add:
      - SYS_RAWIO # required for S.M.A.R.T. data
      - SYS_ADMIN # required for NVMe S.M.A.R.T. data
