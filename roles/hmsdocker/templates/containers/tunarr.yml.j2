{% import 'macros/labels.j2' as labels with context %}
services:
  tunarr:
    image: chrisbenincasa/tunarr:latest
    container_name: tunarr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if 'tunarr' in expose_ports_enabled_containers %}
    ports:
      - 8002:8000
    {% endif %}
    {% if enable_intel_gpu %}
    devices:
      - "/dev/dri:/dev/dri"
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/tunarr/config:/config/tunarr
      # media folder, used by Tunarr "Local" media sources
      - ${HMSD_MOUNT_PATH}:/data{{ ':ro' if 'tunarr' in hmsdocker_readonly_media_containers | default([], true) }}
    environment:
      - TZ=${TIMEZONE}
    {% if enable_nvidia_gpu %}
      - NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    {% if 'tunarr' in traefik_enabled_containers or 'tunarr' in homepage_enabled_containers %}
    labels:
      {% if 'tunarr' in traefik_enabled_containers %}
      {{ labels.traefik('tunarr', 8000) | indent(6) }}
      {% endif %}
      {% if 'tunarr' in homepage_enabled_containers %}
      {{ labels.homepage('tunarr', 'Media', 'Tunarr', 'Live TV Channels') | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8000 || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 20s
