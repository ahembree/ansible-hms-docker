{% import 'macros/labels.j2' as labels with context %}
services:
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    {% if hmsdocker_enable_intel_gpu %}
    devices:
      - /dev/dri:/dev/dri
    {% endif %}
    {% if 'jellyfin' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8096:8096
      - 8920:8920 #optional
      - 7359:7359/udp #optional
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/jellyfin/config:/config
      {% if not hmsdocker_transcode_tmpfs_enabled | default(false) %}
      - {{ hmsdocker_plex_transcode_folder }}/cache:/cache
      {% endif %}
      # media folder where all movies and series are stored
      - ${HMSD_MOUNT_PATH}:/data{{ ':ro' if 'jellyfin' in hmsdocker_readonly_media_containers | default([], true) }}
    {% if hmsdocker_transcode_tmpfs_enabled | default(false) %}
    tmpfs:
      - /cache:size={{ hmsdocker_transcode_tmpfs_size | default('4g') }},mode=1777
    {% endif %}
    environment:
      - TZ=${TIMEZONE}
      - PUID=${PUID}
      - PGID=${PGID}
    {% if hmsdocker_enable_nvidia_gpu %}
      - NVIDIA_VISIBLE_DEVICES=all
    runtime: nvidia
    {% endif %}
    {% if 'jellyfin' in hmsdocker_traefik_enabled_containers or 'jellyfin' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'jellyfin' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('jellyfin', 8096) | indent(6) }}
      {% endif %}
      {% if 'jellyfin' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('jellyfin', 'Media', 'Jellyfin', 'Media Server', widget={'type': 'jellyfin', 'url': 'http://jellyfin:8096', 'version': '2', 'key': '${JELLYFIN_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8096/health || exit 1
      interval: 5s
      timeout: 2s
      retries: 3
      start_period: 60s
