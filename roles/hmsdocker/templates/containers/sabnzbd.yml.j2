{% import 'macros/labels.j2' as labels with context %}
services:
  sabnzbd:
    image: lscr.io/linuxserver/sabnzbd:latest
    container_name: sabnzbd
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
      - download_net
    environment:
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TIMEZONE}
    volumes:
      - ${HMSD_APPS_PATH}/sabnzbd/config:/config
      - ${HMSD_MOUNT_PATH}:/data
    {% if hmsdocker_svc_misc_arr_scripts_enabled | default(false) %}
      - ${HMSD_APPS_PATH}/sabnzbd/custom-cont-init.d:/custom-cont-init.d
    {% endif %}
  {% if 'sabnzbd' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 8082:8080
  {% endif %}
  {% if 'sabnzbd' in hmsdocker_traefik_enabled_containers or 'sabnzbd' in hmsdocker_homepage_enabled_containers %}
    labels:
    {% if 'sabnzbd' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('sabnzbd', 8080) | indent(6) }}
    {% endif %}
    {% if 'sabnzbd' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('sabnzbd', 'Downloads', 'SABnzbd', 'NZB Manager', widget={'type': 'sabnzbd', 'url': 'http://sabnzbd:8080', 'key': '${SABNZBD_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
    {% endif %}
  {% endif %}
    healthcheck:
      test: curl -f http://127.0.0.1:8080/ || exit 1
      interval: 5s
      timeout: 30s
      retries: 3
      start_period: 30s
