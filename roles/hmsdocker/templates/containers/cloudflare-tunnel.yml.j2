{% import 'macros/labels.j2' as labels with context %}
services:
  cloudflare-tunnel:
    image: cloudflare/cloudflared:latest
    container_name: cloudflare-tunnel
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    networks:
      - proxy_net
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    command: tunnel --no-autoupdate run --token ${CLOUDFLARE_TUNNEL_TOKEN}
    {% if 'cloudflare-tunnel' in hmsdocker_homepage_enabled_containers %}
    labels:
      {{ labels.homepage('cloudflare-tunnel', 'Infrastructure', 'Cloudflare Tunnel', 'Cloudflare Tunnel', icon='cloudflare.png', href=none, widget={'type': 'cloudflared', 'accountid': '${CFTUNNEL_ACCT_ID:-apikeyapikeyapikey}', 'tunnelid': '${CFTUNNEL_TUNNEL_ID:-apikeyapikeyapikey}', 'key': '${CFTUNNEL_API_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
    {% endif %}
