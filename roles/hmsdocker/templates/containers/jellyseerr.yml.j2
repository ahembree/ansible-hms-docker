{% import 'macros/labels.j2' as labels with context %}
services:
  jellyseerr:
    image: ghcr.io/seerr-team/seerr:latest
    init: true
    container_name: jellyseerr
    restart: ${RESTART_POLICY}
    security_opt:
      - no-new-privileges:true
    user: ${PUID}:${PGID}
    logging:
      options:
        max-size: "12m"
        max-file: "5"
      driver: json-file
    networks:
      - proxy_net
    environment:
      - LOG_LEVEL=info
      - TZ=${TIMEZONE}
    {% if 'jellyseerr' in hmsdocker_traefik_enabled_containers or 'jellyseerr' in hmsdocker_homepage_enabled_containers %}
    labels:
      {% if 'jellyseerr' in hmsdocker_traefik_enabled_containers %}
      {{ labels.traefik('jellyseerr', 5055) | indent(6) }}
      {% endif %}
      {% if 'jellyseerr' in hmsdocker_homepage_enabled_containers %}
      {{ labels.homepage('jellyseerr', 'Managers', 'Jellyseerr', 'Request Manager', widget={'type': 'seerr', 'url': 'http://jellyseerr:5055', 'key': '${JELLYSEERR_KEY:-apikeyapikeyapikey}'}) | indent(6) }}
      {% endif %}
    {% endif %}
    volumes:
      - ${HMSD_APPS_PATH}/jellyseerr/config:/app/config
    {% if 'jellyseerr' in hmsdocker_expose_ports_enabled_containers %}
    ports:
      - 5056:5055
    {% endif %}
    healthcheck:
      test: wget --no-verbose --tries=1 --spider http://127.0.0.1:5055/api/v1/settings/public || exit 1
      start_period: 20s
      timeout: 3s
      interval: 15s
      retries: 3
