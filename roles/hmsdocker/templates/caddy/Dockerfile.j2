# Managed by hms-docker: Caddy with the DNS provider module (for the Let's Encrypt DNS challenge), the CrowdSec bouncer
# and extra modules
FROM docker.io/library/caddy:{{ hmsdocker_caddy_version }}-builder AS builder
RUN xcaddy build{% for module in hmsdocker_caddy_build_modules %} --with {{ module }}{% endfor +%}

FROM docker.io/library/caddy:{{ hmsdocker_caddy_version }}
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
