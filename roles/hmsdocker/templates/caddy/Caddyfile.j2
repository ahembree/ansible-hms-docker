{#
  Caddy config for the `caddy` container. Mirrors the Traefik config:
  - the routes Traefik builds from container labels (`proxy: true` in the container map, see
    hmsdocker_caddy_upstreams in vars/main.yml), plus the external hosts in hmsdocker_proxy_ext_hosts_list
  - the internal/external IP allowlists, Authentik and Tinyauth forward auth, and the security hardening headers
  - the Let's Encrypt wildcard certificate (DNS challenge) when hmsdocker_ssl_enabled is on
  - the CrowdSec bouncer on every route while `crowdsec` is enabled, and hmsdocker_proxy_trusted_proxies
#}
{% set ssl = hmsdocker_ssl_enabled | default(false) | bool %}
{% set site_prefix = '' if ssl else 'http://' %}
{% set allow_list = ['127.0.0.1/32'] + (hmsdocker_proxy_allow_list | regex_replace(', ', ',') | split(',') | map('trim') | select | list) %}
{% set seen = namespace(hosts=[]) %}
{% set crowdsec = 'crowdsec' in hmsdocker_enabled_containers %}
{% set access_logs = (hmsdocker_proxy_access_logs | default(false) | bool) or crowdsec %}
{% macro site(address, upstream, allowlist=true, outpost='', tinyauth=false, headers={}, host_header='') %}
{{ address }} {
{% if (hmsdocker_proxy_access_logs | default(false) | bool) or 'crowdsec' in hmsdocker_enabled_containers %}
	log
{% endif %}
{% if headers | length > 0 %}
	header {
{% for name, value in headers.items() %}
		{{ name }} "{{ value }}"
{% endfor %}
	}
{% endif %}
	route {
{% if 'crowdsec' in hmsdocker_enabled_containers %}
		import hmsd_crowdsec
{% endif %}
{% if allowlist %}
		import hmsd_internal
{% endif %}
{% if outpost %}
		import hmsd_authentik {{ outpost }}
{% endif %}
{% if tinyauth %}
		import hmsd_tinyauth
{% endif %}
{% if upstream is match('https://') or host_header %}
		reverse_proxy {{ upstream }} {
{% if host_header %}
			# The external host's own hostname, as in backend_url, like Traefik's passHostHeader: false
			header_up Host {{ host_header }}
{% endif %}
{% if upstream is match('https://') %}
			transport http {
				tls_insecure_skip_verify
			}
{% endif %}
		}
{% else %}
		reverse_proxy {{ upstream }}
{% endif %}
	}
}
{% endmacro %}
# Managed by hms-docker, changes to this file are overwritten on the next playbook run
# Add your own sites to `*.caddy` files in {{ hmsdocker_caddy_custom_config_location }}, see the end of this file
{
	admin localhost:2019
	persist_config off
	log {
		level {{ hmsdocker_caddy_log_level | upper }}
		exclude http.log.access
	}
{% if access_logs %}
	# Access logs (hmsdocker_proxy_access_logs, CrowdSec) are written whatever hmsdocker_caddy_log_level is,
	# without API keys and tokens
	log access {
		output stderr
		format filter {
			wrap json
			fields {
{% for header in hmsdocker_caddy_log_redacted_headers %}
				request>headers>{{ header }} delete
{% endfor %}
				request>uri query {
{% for param in hmsdocker_caddy_log_redacted_query %}
					delete {{ param }}
{% endfor %}
				}
			}
		}
		include http.log.access
		level INFO
	}
{% endif %}
{% if ssl %}
	email {{ hmsdocker_ssl_letsencrypt_email }}
	# Only Let's Encrypt, like Traefik. Without this, Caddy falls back to ZeroSSL when Let's Encrypt fails
	acme_ca https://{{ 'acme-staging-v02' if hmsdocker_ssl_letsencrypt_staging else 'acme-v02' }}.api.letsencrypt.org/directory
	acme_dns {{ hmsdocker_caddy_dns_provider }} {{ hmsdocker_caddy_dns_provider_config }}
	tls_resolvers {{ hmsdocker_ssl_dns_resolver_1 }} {{ hmsdocker_ssl_dns_resolver_2 }}
{% if hmsdocker_ssl_sans | default([], true) | length > 0 %}
	# Wildcard certificate(s), sites they cover use them instead of getting their own certificate
	tls_automate_names {{ hmsdocker_ssl_sans | join(' ') }}
{% endif %}
{% else %}
	auto_https off
{% endif %}
{% if hmsdocker_proxy_trusted_proxies | default([], true) | length > 0 %}
	# Proxies in front of Caddy (hmsdocker_proxy_trusted_proxies): the client IP is read from their X-Forwarded-For header
	servers {
		trusted_proxies static {{ hmsdocker_proxy_trusted_proxies | join(' ') }}
		trusted_proxies_strict
	}
{% endif %}
{% if crowdsec %}
	# CrowdSec bouncer, pulls the banned IPs from CrowdSec every 60 seconds (stream mode). If CrowdSec can't be reached,
	# traffic is let through and the last list of bans is kept
	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
		ticker_interval 60s
	}
{% endif %}
}

# Only allows the IPs in hmsdocker_proxy_allow_list (and localhost), other clients get a 403
(hmsd_internal) {
	@hmsd_denied not remote_ip {{ allow_list | join(' ') }}
	respond @hmsd_denied "Forbidden" 403
}

# Authentik forward auth, the argument is the name of the Authentik outpost container
(hmsd_authentik) {
	reverse_proxy /outpost.goauthentik.io/* http://{args[0]}:9000
	forward_auth http://{args[0]}:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers {{ hmsdocker_caddy_authentik_headers | join(' ') }}
		trusted_proxies private_ranges
	}
}

# CrowdSec bouncer: IPs banned by CrowdSec get a 403. Clients in hmsdocker_proxy_allow_list are never blocked, like with
# Traefik. Does nothing while `crowdsec` is disabled
(hmsd_crowdsec) {
{% if crowdsec %}
	@hmsd_crowdsec not client_ip {{ allow_list | join(' ') }}
	crowdsec @hmsd_crowdsec
{% endif %}
}

# Tinyauth forward auth, requires a Tinyauth sign-in
(hmsd_tinyauth) {
	forward_auth http://tinyauth:3000 {
		uri /api/auth/caddy
	}
}

### Containers
{% for name in hmsdocker_caddy_enabled_containers if name in hmsdocker_caddy_upstreams %}
{% set up = hmsdocker_caddy_upstreams[name] %}
{% set up_allowlist = up.allowlist | default(true) | bool %}
{% set up_sso = up_allowlist and (up.sso | default(true) | bool) %}
{% set instances = [''] + (['-4k'] if (up.separate_4k | default(false) and hmsdocker_separate_4k_instances_enable | default(false)) else []) %}
{% for suffix in instances %}
{% set host = (hmsdocker_container_map[name]['proxy_host_rule'] | default(name)) ~ suffix ~ '.' ~ hmsdocker_domain %}
{% if host not in seen.hosts %}
{% set seen.hosts = seen.hosts + [host] %}
{{ site(
    address=site_prefix ~ host,
    upstream=(up.scheme | default('http')) ~ '://' ~ (up.host | default(name)) ~ suffix ~ ':' ~ up.port,
    allowlist=(up_allowlist and name not in hmsdocker_expose_public_enabled_containers),
    outpost=('authentik-proxy-' ~ hmsdocker_project_name ~ '-' ~ name ~ suffix) if (up_sso and name in hmsdocker_authentik_enabled_containers) else '',
    tinyauth=(up_sso and name in hmsdocker_tinyauth_applied_containers),
    headers=((hmsdocker_caddy_security_headers if (hmsdocker_proxy_security_hardening and up_allowlist) else {}) | combine(up.headers | default({})))
) }}
{% endif %}
{% endfor %}
{% endfor %}
{% if hmsdocker_proxy_ext_hosts_enabled | default(false) %}
### External hosts (hmsdocker_proxy_ext_hosts_list)
{% for item in hmsdocker_proxy_ext_hosts_list | default([], true) %}
{% if item.enabled | default(false) and (item.friendly_name | default('')) != '' and (item.subdomain_name | default('')) != '' and (item.backend_url | default('')) != '' %}
{% set host = item.subdomain_name ~ '.' ~ hmsdocker_domain %}
{% if host not in seen.hosts %}
{% set seen.hosts = seen.hosts + [host] %}
# {{ item.friendly_name }}
{{ site(
    address=site_prefix ~ host,
    upstream=item.backend_url | regex_replace('^([A-Za-z][A-Za-z0-9+.-]*://[^/?#]+).*$', '\\1'),
    allowlist=not (item.expose_publicly | default(false)),
    outpost=('authentik-proxy-' ~ hmsdocker_project_name ~ '-' ~ (item.friendly_name | regex_replace(hmsdocker_sanitize_regex, hmsdocker_sanitize_replace))) if ('authentik' in hmsdocker_enabled_containers and ssl and item.authentik | default(false)) else '',
    tinyauth=('tinyauth' in hmsdocker_proxy_enabled_containers and item.tinyauth | default(false)),
    headers=(hmsdocker_caddy_security_headers if hmsdocker_proxy_security_hardening else {}),
    host_header=item.backend_url | regex_replace('^[A-Za-z][A-Za-z0-9+.-]*://([^/?#@]*@)?([^/?#]+).*$', '\\2')
) }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
# Any other host gets a 404, like Traefik (CrowdSec also sees and blocks requests to unknown hosts, e.g. scans of the IP)
{% for catch_all in (['http://', 'https://'] if ssl else ['http://']) %}
{{ catch_all }} {
{% if access_logs %}
	log
{% endif %}
	route {
		import hmsd_crowdsec
		respond 404
	}
}

{% endfor %}
# Health check of the container, and the read-only upstream status for the Homepage widget.
# Only reachable on the Docker network, the admin API itself stays on localhost
http://:2020 {
	handle /healthz {
		respond "OK" 200
	}
	@hmsd_upstreams {
		method GET
		path /reverse_proxy/upstreams
	}
	handle @hmsd_upstreams {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host localhost:2019
		}
	}
	handle {
		respond 404
	}
}

# Your own sites
import /etc/caddy-custom/*.caddy
