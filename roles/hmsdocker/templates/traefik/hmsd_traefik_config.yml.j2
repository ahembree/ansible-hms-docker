global:
  checkNewVersion: true
  sendAnonymousUsage: false

log:
  level: "{{ hmsdocker_traefik_log_level }}"

{% if hmsdocker_traefik_enable_access_logs %}
accessLog: {}
{% endif %}

api:
  dashboard: true
  disabledashboardad: true
  insecure: {{ "false" if hmsdocker_traefik_security_hardening else "true" }}

ping:
  entryPoint: traefik-ping

entryPoints:
  traefik-ping:
    address: :8082
  web:
    address: :80
{% if hmsdocker_traefik_ssl_enabled %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: :443
    asDefault: true
    http3: {}
    http:
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ hmsdocker_traefik_ssl_dns_provider_zone }}"
            sans:
            {% for san in hmsdocker_traefik_ssl_sans %}
              - "{{- san -}}"
            {% endfor %}

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ hmsdocker_traefik_ssl_letsencrypt_email }}"
    {% if hmsdocker_traefik_ssl_use_letsencrypt_staging_url %}
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
      storage: /certs/acme_staging.json
    {% else %}
      storage: /certs/acme.json
    {% endif %}
      dnsChallenge:
        provider: "{{ hmsdocker_traefik_ssl_dns_provider_code }}"
        resolvers:
          - "{{ hmsdocker_traefik_ssl_dns_resolver_1 }}"
          - "{{ hmsdocker_traefik_ssl_dns_resolver_2 }}"
{% endif %}

{% if hmsdocker_traefik_security_hardening and hmsdocker_traefik_ssl_enabled %}
tls:
  options:
    default:
      minVersion: VersionTLS12

    mintls13:
      minVersion: VersionTLS13
{% endif %}

serversTransport:
  insecureSkipVerify: true

providers:
  docker:
    network: "{{ hmsdocker_project_name }}_proxy_net"
    endpoint: unix://{{ (hmsdocker_socket_proxy_client_dir ~ '/docker.sock') if 'traefik' in hmsdocker_socket_proxy_enabled_containers else '/var/run/docker.sock' }}
    exposedByDefault: false
    defaultRule: {% raw %}Host(`{{if index .Labels "com.docker.compose.service" }}{{ index .Labels "com.docker.compose.service" }}{% endraw %}.{{ hmsdocker_domain }}{% raw %}{{else}}{{ trimPrefix `/` .Name }}{% endraw %}.{{ hmsdocker_domain }}{% raw %}{{end}}`){% endraw +%}
  file:
    directory: /etc/traefik/static_files
    watch: true

