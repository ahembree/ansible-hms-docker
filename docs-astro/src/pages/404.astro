---
// Replaces Starlight's built-in 404 route (disabled via `disable404Route` in astro.config.mjs).
// The built-in route looks up an optional `docs/404` entry, which logs a build warning
// when absent on Astro >=7.3.6.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: '404',
		template: 'splash',
		editUrl: false,
		lastUpdated: false,
		pagefind: false,
		hero: {
			tagline: 'Page not found. Check the URL or try using the search bar.',
		},
	}}
/>
